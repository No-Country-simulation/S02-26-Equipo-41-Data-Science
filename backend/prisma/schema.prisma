// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

//////////////////////////////
// ROLES
//////////////////////////////

model Rol {
  rolID  Int    @id @default(autoincrement())
  nombre String

  usuarios Usuario[]
}

//////////////////////////////
// USUARIOS
//////////////////////////////

model Usuario {
  usuarioID    Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  email        String?  @unique
  activo       Boolean  @default(true)
  ultimoLogin  DateTime?

  rolID      Int?
  vendedorID Int?   @unique

  rol      Rol?      @relation(fields: [rolID], references: [rolID])
  vendedor Vendedor? @relation(fields: [vendedorID], references: [vendedorID])
}

//////////////////////////////
// TIEMPO
//////////////////////////////

model Tiempo {
  tiempoID      Int      @id @default(autoincrement())
  fecha         DateTime
  dia           Int?
  mes           Int?
  anio          Int?
  diaSemana     String?
  esFinDeSemana Boolean?

  ventas Venta[]

  @@index([fecha])
}

//////////////////////////////
// SUCURSAL
//////////////////////////////

model Sucursal {
  sucursalID Int    @id @default(autoincrement())
  nombre     String
  ciudad     String?

  vendedores Vendedor[]
  ventas     Venta[]
}

//////////////////////////////
// VENDEDOR
//////////////////////////////

model Vendedor {
  vendedorID Int    @id @default(autoincrement())
  nombre     String

  sucursalID Int?
  sucursal   Sucursal? @relation(fields: [sucursalID], references: [sucursalID])

  ventas  Venta[]
  usuario Usuario?
}

//////////////////////////////
// CLIENTE
//////////////////////////////

model Cliente {
  clienteID Int    @id @default(autoincrement())
  nombre    String
  dni       String? @unique
  telefono  String?

  ventas Venta[]
}

//////////////////////////////
// METODO PAGO
//////////////////////////////

model MetodoPago {
  metodoPagoID Int    @id @default(autoincrement())
  nombre       String

  ventas Venta[]
}

//////////////////////////////
// CATEGORIA
//////////////////////////////

model Categoria {
  categoriaID Int    @id @default(autoincrement())
  nombre      String

  productos Producto[]
}

//////////////////////////////
// MARCA
//////////////////////////////

model Marca {
  marcaID Int    @id @default(autoincrement())
  nombre  String

  productos Producto[]
}

//////////////////////////////
// PRODUCTO
//////////////////////////////

model Producto {
  productoID Int    @id @default(autoincrement())
  nombre     String

  categoriaID Int?
  marcaID     Int?

  categoria Categoria? @relation(fields: [categoriaID], references: [categoriaID])
  marca     Marca?     @relation(fields: [marcaID], references: [marcaID])

  variantes VarianteProducto[]

  @@index([categoriaID])
  @@index([marcaID])
}

//////////////////////////////
// VARIANTE PRODUCTO
//////////////////////////////

model VarianteProducto {
  varianteID  Int     @id @default(autoincrement())
  talla       String?
  color       String?
  sku         String  @unique
  precioVenta Decimal

  productoID Int?
  producto   Producto? @relation(fields: [productoID], references: [productoID])

  detalleVentas DetalleVenta[]

  @@index([productoID])
}

//////////////////////////////
// VENTA
//////////////////////////////

model Venta {
  ventaID Int @id @default(autoincrement())

  sucursalID   Int?
  vendedorID   Int?
  clienteID    Int?
  metodoPagoID Int?
  tiempoID     Int?

  hora       DateTime?
  totalVenta Decimal?

  sucursal   Sucursal?   @relation(fields: [sucursalID], references: [sucursalID])
  vendedor   Vendedor?   @relation(fields: [vendedorID], references: [vendedorID])
  cliente    Cliente?    @relation(fields: [clienteID], references: [clienteID])
  metodoPago MetodoPago? @relation(fields: [metodoPagoID], references: [metodoPagoID])
  tiempo     Tiempo?     @relation(fields: [tiempoID], references: [tiempoID])

  detalles DetalleVenta[]

  @@index([clienteID])
  @@index([vendedorID])
  @@index([sucursalID])
  @@index([tiempoID])
}

//////////////////////////////
// DETALLE VENTA
//////////////////////////////

model DetalleVenta {
  detalleID Int @id @default(autoincrement())

  ventaID    Int?
  varianteID Int?
  cantidad   Int
  precioUnitario Decimal

  venta    Venta?            @relation(fields: [ventaID], references: [ventaID])
  variante VarianteProducto? @relation(fields: [varianteID], references: [varianteID])

  @@index([ventaID])
  @@index([varianteID])
}