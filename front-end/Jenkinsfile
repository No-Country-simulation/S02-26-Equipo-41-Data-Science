pipeline {
    agent none 

    stages {
        stage('Fix Permissions & Cleanup') {
            agent {
                docker { 
                    image 'alpine'
                    args '-u root' 
                }
            }
            steps {
                echo '🧹 Limpiando desde la carpeta front-end...'
                // Al estar dentro de front-end, borramos lo local
                sh 'rm -rf node_modules .npm || true'
            }
        }

        stage('Install & Build Frontend') {
            agent {
                docker { 
                    image 'node:20-alpine' 
                    args '-u root'
                }
            }
            steps {
                echo '📦 Instalando dependencias en front-end...'
                sh 'npm install'
                sh 'npm run build --if-present'
            }
        }

        stage('Build Docker Image') {
            agent any 
            steps {
                script {
                    // Ya estamos en la carpeta front-end, así que el Dockerfile está aquí mismo
                    if (fileExists('Dockerfile')) {
                        echo '🐳 Construyendo imagen usando el Dockerfile local...'
                        sh 'docker build -t frontend-equipo-41:latest .'
                    } else {
                        error "❌ No se encontró el Dockerfile en ${pwd()}"
                    }
                }
            }
        }
    }

    post {
        success { echo '✅ ¡Pipeline de Front exitoso!' }
        failure { echo '❌ Falló el pipeline de Front.' }
    }
}