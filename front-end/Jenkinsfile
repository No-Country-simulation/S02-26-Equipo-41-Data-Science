pipeline {
    agent none 

    stages {
        // --- ETAPA 1: LIMPIEZA DE PERMISOS ---
        stage('Fix Permissions & Cleanup') {
            agent {
                docker { 
                    image 'alpine'
                    args '-u root' 
                }
            }
            steps {
                dir('front-end') {
                    echo '🧹 Limpiando node_modules antiguos con permisos de root...'
                    sh 'rm -rf node_modules .npm || true'
                }
            }
        }

        // --- ETAPA 2: INSTALACIÓN Y BUILD ---
        stage('Install & Build Frontend') {
            agent {
                docker { 
                    image 'node:20-alpine' 
                    args '-u root'
                }
            }
            steps {
                dir('front-end') {
                    echo '📦 Instalando dependencias en carpeta front-end...'
                    sh 'npm install'
                    echo '🏗️ Ejecutando build si existe el script...'
                    sh 'npm run build --if-present'
                }
            }
        }

        // --- ETAPA 3: CONSTRUCCIÓN DE IMAGEN DOCKER ---
        stage('Build Docker Image') {
            agent any 
            steps {
                script {
                    dir('front-end') {
                        // Verificamos que el Dockerfile que no quieres tocar esté ahí
                        if (fileExists('Dockerfile')) {
                            echo '🐳 Construyendo imagen usando tu Dockerfile original...'
                            sh 'docker build -t frontend-equipo-41:latest .'
                        } else {
                            error "❌ ERROR: No se encontró el Dockerfile en la carpeta front-end/"
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo '✅ ¡Pipeline finalizado con éxito! La imagen Docker ha sido creada.'
        }
        failure {
            echo '❌ El pipeline falló. Revisa los logs de arriba para ver el error.'
        }
    }
}