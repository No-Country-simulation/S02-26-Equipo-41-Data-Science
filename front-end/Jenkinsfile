pipeline {
    agent none // Sin agente global para usar uno específico por etapa

    stages { // <--- Faltaba esta palabra clave para agrupar las etapas
        
        stage('Install & Build Frontend') {
            agent {
                docker { 
                    image 'node:20-alpine'
                    args '-u root' 
                }
            }
            steps {
                dir('front-end') {
                    echo '📦 Instalando dependencias...'
                    sh 'npm install'
                    echo '🏗️ Generando build...'
                    sh 'npm run build --if-present'
                }
            }
        }

        stage('Build Docker Image') {
            agent any // Volvemos al host para usar el comando Docker
            steps {
                script {
                    if (fileExists('Dockerfile')) {
                        echo '🐳 Construyendo imagen desde el host...'
                        sh 'docker build -t frontend-equipo-41:latest .'
                    } else {
                        echo '❌ No se encontró el Dockerfile en la raíz'
                    }
                }
            }
        }
    } // Fin de stages

    post {
        success { echo '✅ ¡Pipeline exitoso!' }
        failure { echo '❌ Falló el pipeline.' }
    }
}